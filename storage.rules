rules_version = '2';

// Kachava Lux Maintenance - Cloud Storage Security Rules
// Photos: maintenanceRequests/{reqId}/{before|after}/{photoId}
// Access mirrors firestore.rules via cross-service Firestore lookups.

service firebase.storage {
  match /b/{bucket}/o {

    function emailLower() {
      return request.auth.token.email.lower();
    }

    function hasCompanyIdentity() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email is string
        && emailLower().matches('^[^@]+@kachavalux[.]com$');
    }

    function userPath() {
      return /databases/(default)/documents/users/$(emailLower());
    }

    function isApproved() {
      return hasCompanyIdentity()
        && firestore.exists(userPath())
        && firestore.get(userPath()).data.active == true;
    }

    function isSupervisor() {
      return isApproved() && firestore.get(userPath()).data.role in ['supervisor', 'admin'];
    }

    function isAdmin() {
      return isApproved() && firestore.get(userPath()).data.role == 'admin';
    }

    function requestPath(reqId) {
      return /databases/(default)/documents/maintenanceRequests/$(reqId);
    }

    function requestData(reqId) {
      return firestore.get(requestPath(reqId)).data;
    }

    function isSubmitter(reqId) {
      return requestData(reqId).submittedBy.uid == request.auth.uid;
    }

    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /maintenanceRequests/{reqId}/{kind}/{photoId} {
      allow read: if isApproved()
        && firestore.exists(requestPath(reqId))
        && (isSupervisor() || isSubmitter(reqId));

      allow create: if isApproved()
        && resource == null
        && firestore.exists(requestPath(reqId))
        && isValidImage()
        && (
          (kind == 'before' && isSubmitter(reqId) && requestData(reqId).status == 'sin_revisar')
          || (kind == 'after' && isSupervisor() && requestData(reqId).status != 'completada')
          || (kind == 'reopen' && isAdmin() && requestData(reqId).status == 'completada')
        );

      // Evidence is immutable.
      allow update, delete: if false;
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
