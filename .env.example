# Kachava Lux Maintenance - frontend environment template.
# Copy to `.env.local` (development) or `.env.production` (build for deploy).
# Real `.env*` files are gitignored. Firebase web config values are not secrets,
# but keep them out of the repo so each environment is configured explicitly.
# Find them in Firebase console > Project settings > Your apps > Web app.

VITE_FIREBASE_API_KEY=""
# Must be the Hosting domain so Microsoft sign-in redirect works on iOS Safari.
VITE_FIREBASE_AUTH_DOMAIN="kachava-lux-ops.web.app"
VITE_FIREBASE_PROJECT_ID="kachava-lux-ops"
VITE_FIREBASE_STORAGE_BUCKET="kachava-lux-ops.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Microsoft Entra ID (Azure AD) Directory (tenant) ID of kachavalux.com.
VITE_MS_TENANT_ID=""

# Set to "true" to point the app at the local Firebase emulators
# (auth 9098, firestore 8085, storage 9198). Never true in production.
VITE_USE_EMULATORS="false"
